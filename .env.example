# ArXiv MCP Server — environment variables
# Copy this to .env and fill in your values.

# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text         # text | json  (json is friendlier for log aggregators)

# Semantic Scholar (optional)
# Without a key: ~1 req/s (plenty for interactive use).
# With a key:   ~10 req/s (better for bulk workflows).
# Apply free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# HTTP access control
# Leave MCP_API_KEY unset for the default: open access (like ArXiv's own
# API) protected by per-IP throttling. Set it to require every HTTP
# request to present `Authorization: Bearer <value>`.
MCP_API_KEY=
RATE_LIMIT_PER_MINUTE=30

# Comma-separated list of origins to allow for browser-based MCP clients,
# e.g. "https://my-app.example.com,https://localhost:3000". Leave unset if
# only server-to-server or desktop-app clients will connect — the default
# deployment does not expect in-browser JS clients.
ALLOWED_ORIGINS=

# Outbound HTTP behavior
# Overall wall-clock budget (seconds) for a single tool call's external
# HTTP work, including retries. Keep this comfortably under your hosting
# platform's own hard request timeout.
REQUEST_DEADLINE_SECONDS=20

# Startup polish
FASTMCP_SHOW_SERVER_BANNER=true
FASTMCP_CHECK_FOR_UPDATES=stable